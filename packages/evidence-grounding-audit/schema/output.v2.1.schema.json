{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchscope.local/skills/evidence-grounding-audit/output.v2.1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "status", "result_summary", "structured_output", "evidence_refs", "confidence", "risks", "needs_human_review", "failure_reason", "retryable"],
  "properties": {
    "task_id": {"type": "string"},
    "status": {"enum": ["completed", "blocked"]},
    "result_summary": {"type": "string"},
    "structured_output": {
      "type": ["object", "null"],
      "properties": {
        "meta": {"type": "object"},
        "claims": {"type": "array"},
        "evidence": {"type": "array"},
        "support_links": {"type": "array"},
        "calibration_decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claim_id", "verdict", "support_strength", "independent_source_count", "freshness_status", "freshness_score", "evidence_ids", "source_locator_ids", "citation_status", "score_bearing"],
            "properties": {
              "claim_id": {"type": "string"},
              "verdict": {"enum": ["PASS", "DOWNGRADE", "REQUEST_MORE_EVIDENCE", "REJECT"]},
              "support_strength": {"enum": ["STRONG", "MODERATE", "WEAK", "NONE"]},
              "independent_source_count": {"type": "integer", "minimum": 0},
              "freshness_status": {"enum": ["VALID", "NEAR_EXPIRY", "EXPIRED", "SUPERSEDED"]},
              "freshness_score": {"type": "number", "minimum": 0, "maximum": 1},
              "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
              "source_locator_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
              "citation_status": {"enum": ["VERIFIED", "DOWNGRADED", "PENDING_VALIDATION", "REJECTED"]},
              "score_bearing": {"type": "boolean"}
            }
          }
        },
        "canonical_claims": {"type": "array"},
        "conflicts": {"type": "array"},
        "decision_tensions": {"type": "array"},
        "evidence_gaps": {"type": "array"},
        "cross_agent_issues": {"type": "array"},
        "supervisor_handoff": {"type": "object"},
        "reports": {"type": "object"},
        "structured_output_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "required": ["meta", "claims", "evidence", "support_links", "calibration_decisions", "canonical_claims", "conflicts", "decision_tensions", "evidence_gaps", "cross_agent_issues", "supervisor_handoff", "reports", "structured_output_digest"]
    },
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "risks": {"type": "array", "items": {"type": "string"}},
    "needs_human_review": {"type": "boolean"},
    "failure_reason": {"type": ["string", "null"]},
    "retryable": {"type": "boolean"}
  }
}
