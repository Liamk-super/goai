{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchscope.local/contracts/reports/specialist-report.v3.json",
  "title": "SpecialistReportDocumentV3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "locale", "report_id", "run_id", "project_id", "product_version_id", "product_title",
    "agent_code", "source_sha256", "executive_summary", "metrics", "claims", "domain_payload", "risks", "actions",
    "citations", "source_directory", "audit_summary", "raw_audit_refs"
  ],
  "properties": {
    "schema_version": {"const": "3.0"},
    "locale": {"enum": ["zh-CN", "en"]},
    "report_id": {"$ref": "#/$defs/uuid"},
    "run_id": {"$ref": "#/$defs/uuid"},
    "project_id": {"$ref": "#/$defs/uuid"},
    "product_version_id": {"$ref": "#/$defs/uuid"},
    "product_title": {"type": "string", "minLength": 1, "maxLength": 300},
    "agent_code": {"$ref": "#/$defs/agentCode"},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "executive_summary": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/claimId"}},
    "metrics": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "value", "claim_ids"],
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "value": {"type": ["string", "number", "boolean"]},
          "claim_ids": {"$ref": "#/$defs/claimIds"}
        }
      }
    },
    "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
    "domain_payload": {
      "oneOf": [
        {"$ref": "#/$defs/userPayload"},
        {"$ref": "#/$defs/productPayload"},
        {"$ref": "#/$defs/investmentPayload"},
        {"$ref": "#/$defs/auditPayload"}
      ]
    },
    "risks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/claimId"}},
    "actions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/action"}},
    "citations": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
    "source_directory": {"type": "array", "items": {"$ref": "#/$defs/sourceLocator"}},
    "audit_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "insufficient", "needs_more", "conflicted"],
      "properties": {
        "verified": {"type": "integer", "minimum": 0},
        "insufficient": {"type": "integer", "minimum": 0},
        "needs_more": {"type": "integer", "minimum": 0},
        "conflicted": {"type": "integer", "minimum": 0}
      }
    },
    "raw_audit_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"agent_code": {"const": "user-evidence"}}, "required": ["agent_code"]},
      "then": {"properties": {"domain_payload": {"$ref": "#/$defs/userPayload"}}}
    },
    {
      "if": {"properties": {"agent_code": {"const": "product-engineering"}}, "required": ["agent_code"]},
      "then": {"properties": {"domain_payload": {"$ref": "#/$defs/productPayload"}}}
    },
    {
      "if": {"properties": {"agent_code": {"const": "business-investment"}}, "required": ["agent_code"]},
      "then": {"properties": {"domain_payload": {"$ref": "#/$defs/investmentPayload"}}}
    },
    {
      "if": {"properties": {"agent_code": {"const": "evidence-auditor"}}, "required": ["agent_code"]},
      "then": {"properties": {"domain_payload": {"$ref": "#/$defs/auditPayload"}}}
    }
  ],
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "agentCode": {"enum": ["user-evidence", "product-engineering", "business-investment", "evidence-auditor"]},
    "claimId": {"type": "string", "pattern": "^claim-[A-Za-z0-9._-]+$"},
    "claimIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/claimId"}},
    "nonEmptyStrings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "userPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target_segments", "jobs_and_scenarios", "behavioral_evidence", "retention_and_payment", "validation_plan"],
      "properties": {
        "kind": {"const": "USER_EVIDENCE"},
        "target_segments": {"$ref": "#/$defs/nonEmptyStrings"},
        "jobs_and_scenarios": {"$ref": "#/$defs/nonEmptyStrings"},
        "behavioral_evidence": {"$ref": "#/$defs/nonEmptyStrings"},
        "retention_and_payment": {"$ref": "#/$defs/nonEmptyStrings"},
        "validation_plan": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "productPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "stage_gate", "core_flows", "delivery_and_reliability", "dependencies_and_security", "retest_gates"],
      "properties": {
        "kind": {"const": "PRODUCT_ENGINEERING"},
        "stage_gate": {"type": "string", "minLength": 1},
        "core_flows": {"$ref": "#/$defs/nonEmptyStrings"},
        "delivery_and_reliability": {"$ref": "#/$defs/nonEmptyStrings"},
        "dependencies_and_security": {"$ref": "#/$defs/nonEmptyStrings"},
        "retest_gates": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "investmentPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "business_model", "unit_economics", "competition_and_market", "investment_gates", "compliance_scope"],
      "properties": {
        "kind": {"const": "BUSINESS_INVESTMENT"},
        "business_model": {"$ref": "#/$defs/nonEmptyStrings"},
        "unit_economics": {"$ref": "#/$defs/nonEmptyStrings"},
        "competition_and_market": {"$ref": "#/$defs/nonEmptyStrings"},
        "investment_gates": {"$ref": "#/$defs/nonEmptyStrings"},
        "compliance_scope": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "auditPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "coverage_by_dimension", "source_independence", "conflicts", "calibration_decisions", "evidence_gaps"],
      "properties": {
        "kind": {"const": "EVIDENCE_AUDIT"},
        "coverage_by_dimension": {"$ref": "#/$defs/nonEmptyStrings"},
        "source_independence": {"$ref": "#/$defs/nonEmptyStrings"},
        "conflicts": {"$ref": "#/$defs/nonEmptyStrings"},
        "calibration_decisions": {"$ref": "#/$defs/nonEmptyStrings"},
        "evidence_gaps": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "section", "text", "status", "decision_relevance", "citation_ids", "score_bearing"],
      "properties": {
        "claim_id": {"$ref": "#/$defs/claimId"},
        "section": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1, "maxLength": 12000},
        "status": {"enum": ["VERIFIED", "DOWNGRADED", "PENDING_VALIDATION", "CONFLICTED"]},
        "decision_relevance": {"enum": ["CRITICAL", "IMPORTANT", "CONTEXT"]},
        "citation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^citation-[A-Za-z0-9._-]+$"}},
        "score_bearing": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "VERIFIED"}}, "required": ["status"]},
          "then": {"properties": {"citation_ids": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"status": {"enum": ["PENDING_VALIDATION", "CONFLICTED"]}}, "required": ["status"]},
          "then": {"properties": {"score_bearing": {"const": false}}}
        }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "title", "owner", "deadline_days", "success_criteria", "failure_triggers", "required_evidence", "related_claim_ids"],
      "properties": {
        "action_id": {"type": "string", "pattern": "^action-[A-Za-z0-9._-]+$"},
        "title": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "deadline_days": {"type": "integer", "minimum": 1, "maximum": 365},
        "success_criteria": {"$ref": "#/$defs/nonEmptyStrings"},
        "failure_triggers": {"$ref": "#/$defs/nonEmptyStrings"},
        "required_evidence": {"$ref": "#/$defs/nonEmptyStrings"},
        "related_claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/claimId"}}
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["citation_id", "claim_id", "evidence_id", "source_locator_id", "support_role", "audit_status", "label"],
      "properties": {
        "citation_id": {"type": "string", "pattern": "^citation-[A-Za-z0-9._-]+$"},
        "claim_id": {"$ref": "#/$defs/claimId"},
        "evidence_id": {"$ref": "#/$defs/uuid"},
        "source_locator_id": {"type": ["string", "null"], "format": "uuid"},
        "support_role": {"enum": ["SUPPORT", "COUNTER", "BACKGROUND"]},
        "audit_status": {"enum": ["VERIFIED", "DOWNGRADED", "REJECTED", "NEEDS_MORE"]},
        "label": {"type": "integer", "minimum": 1}
      }
    },
    "sourceLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_locator_id", "evidence_id", "source_kind", "title", "fetched_at", "locator", "independence_group", "content_sha256"],
      "properties": {
        "source_locator_id": {"$ref": "#/$defs/uuid"},
        "evidence_id": {"$ref": "#/$defs/uuid"},
        "source_kind": {"enum": ["PUBLIC_URL", "SEARCH_RESULT", "INTERNAL_MATERIAL"]},
        "canonical_url": {"type": "string", "format": "uri"},
        "title": {"type": "string", "minLength": 1},
        "publisher": {"type": ["string", "null"]},
        "published_at": {"type": ["string", "null"], "format": "date-time"},
        "fetched_at": {"type": "string", "format": "date-time"},
        "locator": {"type": "object"},
        "region": {"type": ["string", "null"]},
        "independence_group": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
