{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchscope.local/contracts/reports/supervisor-report.v2.json",
  "title": "SupervisorReportDocumentV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "report_id", "run_id", "project_id", "product_version_id", "product_title", "source_sha256",
    "top_card", "summary_claim_id", "claims", "highlights", "critical_issues", "role_summaries",
    "cross_domain_claims", "actions", "confidence_breakdown", "agent_report_cards", "citations", "source_directory",
    "audit_detail_ref"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "report_id": {"type": "string", "format": "uuid"},
    "run_id": {"type": "string", "format": "uuid"},
    "project_id": {"type": "string", "format": "uuid"},
    "product_version_id": {"type": "string", "format": "uuid"},
    "product_title": {"type": "string", "minLength": 1, "maxLength": 300},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "top_card": {
      "type": "object", "additionalProperties": false,
      "required": ["potential_index", "stage", "confidence_band", "evidence_coverage", "recommendation"],
      "properties": {
        "potential_index": {"type": "number", "minimum": 0, "maximum": 100},
        "stage": {"type": "string", "minLength": 1},
        "confidence_band": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "evidence_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "recommendation": {"$ref": "#/$defs/recommendation"}
      }
    },
    "comparison": {
      "type": "object",
      "description": "Immutable ReportComparisonV1; omitted for first evaluation and same-input reruns."
    },
    "summary_claim_id": {"$ref": "#/$defs/claimId"},
    "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
    "highlights": {"$ref": "#/$defs/claimIds"},
    "critical_issues": {"$ref": "#/$defs/claimIds"},
    "role_summaries": {
      "type": "object", "additionalProperties": false,
      "required": ["user", "product", "investment"],
      "properties": {
        "user": {"$ref": "#/$defs/claimIds"},
        "product": {"$ref": "#/$defs/claimIds"},
        "investment": {"$ref": "#/$defs/claimIds"}
      }
    },
    "cross_domain_claims": {"$ref": "#/$defs/claimIds"},
    "actions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/action"}},
    "confidence_breakdown": {
      "type": "object", "additionalProperties": false,
      "required": [
        "profile_ref", "audited_evidence_quality", "evidence_coverage", "independent_source_support", "freshness",
        "cross_domain_agreement", "unresolved_conflict_penalty", "score", "band"
      ],
      "properties": {
        "profile_ref": {"type": "string", "minLength": 1},
        "audited_evidence_quality": {"$ref": "#/$defs/unitInterval"},
        "evidence_coverage": {"$ref": "#/$defs/unitInterval"},
        "independent_source_support": {"$ref": "#/$defs/unitInterval"},
        "freshness": {"$ref": "#/$defs/unitInterval"},
        "cross_domain_agreement": {"$ref": "#/$defs/unitInterval"},
        "unresolved_conflict_penalty": {"$ref": "#/$defs/unitInterval"},
        "score": {"$ref": "#/$defs/unitInterval"},
        "band": {"enum": ["LOW", "MEDIUM", "HIGH"]}
      }
    },
    "agent_report_cards": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["agent_code", "report_id", "title", "summary_claim_ids", "source_sha256"],
        "properties": {
          "agent_code": {"enum": ["user-evidence", "product-engineering", "business-investment", "evidence-auditor"]},
          "report_id": {"type": "string", "format": "uuid"},
          "title": {"type": "string", "minLength": 1},
          "summary_claim_ids": {"$ref": "#/$defs/claimIds"},
          "source_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "citations": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
    "source_directory": {"type": "array", "items": {"$ref": "#/$defs/sourceLocator"}},
    "audit_detail_ref": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "unitInterval": {"type": "number", "minimum": 0, "maximum": 1},
    "recommendation": {"enum": ["PROCEED", "VALIDATE_FURTHER", "ADJUST", "PAUSE"]},
    "claimId": {"type": "string", "pattern": "^claim-[A-Za-z0-9._-]+$"},
    "claimIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/claimId"}},
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_id", "section", "text", "status", "decision_relevance", "citation_ids", "score_bearing"],
      "properties": {
        "claim_id": {"$ref": "#/$defs/claimId"},
        "section": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1, "maxLength": 12000},
        "status": {"enum": ["VERIFIED", "DOWNGRADED", "PENDING_VALIDATION", "CONFLICTED"]},
        "decision_relevance": {"enum": ["CRITICAL", "IMPORTANT", "CONTEXT"]},
        "citation_ids": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "pattern": "^citation-[A-Za-z0-9._-]+$"}
        },
        "score_bearing": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "VERIFIED"}, "decision_relevance": {"const": "CRITICAL"}},
            "required": ["status", "decision_relevance"]
          },
          "then": {"not": {"properties": {"citation_ids": {"maxItems": 0}}, "required": ["citation_ids"]}}
        },
        {
          "if": {"properties": {"status": {"const": "PENDING_VALIDATION"}}, "required": ["status"]},
          "then": {"properties": {"score_bearing": {"const": false}}}
        }
      ]
    },
    "action": {
      "type": "object", "additionalProperties": false,
      "required": [
        "action_id", "title", "owner", "deadline_days", "success_criteria", "failure_triggers", "required_evidence",
        "related_claim_ids"
      ],
      "properties": {
        "action_id": {"type": "string", "pattern": "^action-[A-Za-z0-9._-]+$"},
        "title": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "deadline_days": {"type": "integer", "minimum": 1, "maximum": 365},
        "success_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "failure_triggers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "required_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "related_claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/claimId"}}
      }
    },
    "citation": {
      "type": "object", "additionalProperties": false,
      "required": ["citation_id", "claim_id", "evidence_id", "source_locator_id", "support_role", "audit_status", "label"],
      "properties": {
        "citation_id": {"type": "string", "pattern": "^citation-[A-Za-z0-9._-]+$"},
        "claim_id": {"$ref": "#/$defs/claimId"},
        "evidence_id": {"type": "string", "format": "uuid"},
        "source_locator_id": {"type": ["string", "null"], "format": "uuid"},
        "support_role": {"enum": ["SUPPORT", "COUNTER", "BACKGROUND"]},
        "audit_status": {"enum": ["VERIFIED", "DOWNGRADED", "REJECTED", "NEEDS_MORE"]},
        "label": {"type": "integer", "minimum": 1}
      }
    },
    "sourceLocator": {
      "type": "object", "additionalProperties": false,
      "required": [
        "source_locator_id", "evidence_id", "source_kind", "title", "fetched_at", "locator", "independence_group",
        "content_sha256"
      ],
      "properties": {
        "source_locator_id": {"type": "string", "format": "uuid"},
        "evidence_id": {"type": "string", "format": "uuid"},
        "source_kind": {"enum": ["PUBLIC_URL", "SEARCH_RESULT", "INTERNAL_MATERIAL"]},
        "canonical_url": {"type": "string", "format": "uri"},
        "title": {"type": "string", "minLength": 1},
        "publisher": {"type": ["string", "null"]},
        "published_at": {"type": ["string", "null"], "format": "date-time"},
        "fetched_at": {"type": "string", "format": "date-time"},
        "locator": {"type": "object"},
        "region": {"type": ["string", "null"]},
        "independence_group": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
