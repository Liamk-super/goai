{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchscope.local/contracts/intake/requirement-brief.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "brief_id", "tenant_id", "product_version_id", "revision", "raw_input_ref",
    "normalized_goal", "evaluation_mode", "requested_deliverables", "constraints", "success_criteria",
    "explicit_facts", "assumptions", "unknowns", "confidence", "confirmation_required",
    "confirmation_reasons", "change_classification"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "brief_id": { "type": "string", "format": "uuid" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "product_version_id": { "type": "string", "format": "uuid" },
    "revision": { "type": "integer", "minimum": 1 },
    "raw_input_ref": { "$ref": "#/$defs/contentRef" },
    "normalized_goal": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "evaluation_mode": {
      "enum": ["FULL_POTENTIAL", "INVESTMENT_REVIEW", "LAUNCH_REVIEW", "USER_VALIDATION"]
    },
    "requested_deliverables": {
      "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "constraints": {
      "type": "array", "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "success_criteria": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "explicit_facts": {
      "type": "object", "maxProperties": 100,
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 4000 }
    },
    "assumptions": {
      "type": "array", "maxItems": 30,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["field", "value", "material"],
        "properties": {
          "field": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "value": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "material": { "type": "boolean" }
        }
      }
    },
    "unknowns": {
      "type": "array", "maxItems": 50, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
    },
    "confidence": {
      "type": "object", "additionalProperties": false,
      "required": ["overall", "fields"],
      "properties": {
        "overall": { "type": "number", "minimum": 0, "maximum": 1 },
        "fields": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "confirmation_required": { "type": "boolean" },
    "confirmation_reasons": {
      "type": "array", "uniqueItems": true,
      "items": {
        "enum": ["CRITICAL_AMBIGUITY", "MODEL_ASSUMPTION", "SCOPE_CHANGE", "COST_CHANGE", "NEW_PERMISSION"]
      }
    },
    "change_classification": { "enum": ["INITIAL", "SUPPLEMENT", "REQUIREMENT_CHANGE"] }
  },
  "$defs": {
    "contentRef": {
      "type": "object", "additionalProperties": false,
      "required": ["object_key", "sha256"],
      "properties": {
        "object_key": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
