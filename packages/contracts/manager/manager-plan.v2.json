{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchscope.local/contracts/manager/manager-plan.v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "plan_id", "run_id", "brief_id", "plan_version", "supersedes_plan_id",
    "evaluation_mode", "score_profile_ref", "tasks", "trimmed_domains", "budget_suggestion",
    "deadline_suggestion_seconds", "completion_policy", "replan_reason"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "plan_id": {"type": "string", "format": "uuid"},
    "run_id": {"type": "string", "format": "uuid"},
    "brief_id": {"type": "string", "format": "uuid"},
    "plan_version": {"type": "integer", "minimum": 1},
    "supersedes_plan_id": {"type": ["string", "null"], "format": "uuid"},
    "evaluation_mode": {"enum": ["FULL_POTENTIAL", "INVESTMENT_REVIEW", "LAUNCH_REVIEW", "USER_VALIDATION"]},
    "score_profile_ref": {"type": "string", "pattern": "^score-profile:[a-z-]+@1\\.0$"},
    "tasks": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/domainTask"}},
    "trimmed_domains": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["agent_code", "reason"],
        "properties": {
          "agent_code": {"$ref": "#/$defs/domainAgent"},
          "reason": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "budget_suggestion": {"type": "number", "minimum": 0},
    "deadline_suggestion_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "completion_policy": {"enum": ["REQUIRE_ALL", "ALLOW_PARTIAL_OPTIONAL"]},
    "replan_reason": {"type": ["string", "null"], "maxLength": 2000}
  },
  "$defs": {
    "domainAgent": {"type": "string", "enum": ["user-evidence", "product-engineering", "business-investment"]},
    "materialScope": {
      "type": "object", "additionalProperties": false,
      "required": ["scope_id", "material_id", "unit_refs", "reason", "required"],
      "properties": {
        "scope_id": {"type": "string", "format": "uuid"},
        "material_id": {"type": "string", "format": "uuid"},
        "unit_refs": {
          "type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^material-unit:[0-9a-f-]{36}@[a-f0-9]{64}$"}
        },
        "reason": {"type": "string", "minLength": 1, "maxLength": 1000},
        "required": {"type": "boolean"}
      }
    },
    "domainTask": {
      "type": "object", "additionalProperties": false,
      "required": [
        "task_key", "target_agent", "input_refs", "material_scope", "analysis_dimensions", "region_scope", "as_of",
        "tool_policy", "success_conditions", "required", "dependencies", "budget_suggestion", "deadline_seconds"
      ],
      "properties": {
        "task_key": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
        "target_agent": {"$ref": "#/$defs/domainAgent"},
        "input_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "maxLength": 1024}},
        "material_scope": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/materialScope"}},
        "analysis_dimensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "maxLength": 120}},
        "region_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "as_of": {"type": "string", "format": "date"},
        "tool_policy": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "success_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "maxLength": 1000}},
        "required": {"type": "boolean"},
        "dependencies": {"type": "array", "maxItems": 0},
        "budget_suggestion": {"type": "number", "minimum": 0},
        "deadline_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
      }
    }
  }
}

