{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchscope.local/contracts/material/material-selection.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "selection_id", "product_version_id", "revision", "items", "confirmed_by", "confirmed_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "selection_id": {"type": "string", "format": "uuid"},
    "product_version_id": {"type": "string", "format": "uuid"},
    "revision": {"type": "integer", "minimum": 1},
    "items": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["material_id", "analysis_id", "decision", "acknowledged_uncovered_locators"],
        "properties": {
          "material_id": {"type": "string", "format": "uuid"},
          "analysis_id": {"type": "string", "format": "uuid"},
          "decision": {"enum": ["INCLUDE", "INCLUDE_PARTIAL", "EXCLUDE"]},
          "acknowledged_uncovered_locators": {"type": "array", "maxItems": 500, "items": {"type": "object"}}
        }
      }
    },
    "confirmed_by": {"type": "string", "minLength": 1, "maxLength": 255},
    "confirmed_at": {"type": "string", "format": "date-time"}
  }
}
