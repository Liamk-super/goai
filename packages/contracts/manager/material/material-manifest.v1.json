{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchscope.local/contracts/material/material-manifest.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "manifest_id", "material_id", "product_version_id", "source_ref", "status",
    "parser_version", "page_count", "unit_count", "coverage", "root_unit_refs", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "manifest_id": {"type": "string", "format": "uuid"},
    "material_id": {"type": "string", "format": "uuid"},
    "product_version_id": {"type": "string", "format": "uuid"},
    "source_ref": {"$ref": "#/$defs/contentRef"},
    "status": {"enum": ["QUEUED", "PARSING", "NEEDS_CONSENT", "READY", "PARTIAL", "FAILED", "EXCLUDED"]},
    "parser_version": {"type": "string", "minLength": 1, "maxLength": 80},
    "model_id": {"type": ["string", "null"], "maxLength": 200},
    "page_count": {"type": "integer", "minimum": 0, "maximum": 500},
    "unit_count": {"type": "integer", "minimum": 0, "maximum": 10000},
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["total", "parsed", "visual_inspected", "uncovered_locators"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "parsed": {"type": "integer", "minimum": 0},
        "visual_inspected": {"type": "integer", "minimum": 0},
        "uncovered_locators": {"type": "array", "maxItems": 500, "items": {"type": "object"}}
      }
    },
    "root_unit_refs": {"type": "array", "maxItems": 500, "uniqueItems": true, "items": {"$ref": "#/$defs/unitRef"}},
    "error_code": {"type": ["string", "null"], "maxLength": 120},
    "error_message": {"type": ["string", "null"], "maxLength": 2000},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "contentRef": {
      "type": "object", "additionalProperties": false, "required": ["object_key", "sha256"],
      "properties": {
        "object_key": {"type": "string", "minLength": 1, "maxLength": 1024},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "unitRef": {"type": "string", "pattern": "^material-unit:[0-9a-f-]{36}@[a-f0-9]{64}$"}
  }
}
