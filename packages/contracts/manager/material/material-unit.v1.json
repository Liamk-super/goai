{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchscope.local/contracts/material/material-unit.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "unit_id", "manifest_id", "material_id", "ordinal", "unit_type", "locator",
    "tags", "confidence", "contains_sensitive_data", "content_ref", "summary"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "unit_id": {"type": "string", "format": "uuid"},
    "manifest_id": {"type": "string", "format": "uuid"},
    "material_id": {"type": "string", "format": "uuid"},
    "parent_unit_id": {"type": ["string", "null"], "format": "uuid"},
    "ordinal": {"type": "integer", "minimum": 1, "maximum": 10000},
    "unit_type": {"enum": ["DOCUMENT", "SECTION", "PAGE", "PARAGRAPH", "TABLE", "IMAGE"]},
    "locator": {"type": "object", "maxProperties": 12, "additionalProperties": true},
    "tags": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "maxLength": 80}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "contains_sensitive_data": {"type": "boolean"},
    "content_ref": {
      "type": "object", "additionalProperties": false, "required": ["object_key", "sha256"],
      "properties": {
        "object_key": {"type": "string", "minLength": 1, "maxLength": 1024},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "summary": {"type": "string", "maxLength": 2000}
  }
}
