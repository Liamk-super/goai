{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchscope.local/contracts/handoffs/agent-handoff.v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "tenant_id", "run_id", "task_id", "agent_code", "status", "dimension",
    "claims", "evidence_refs", "risk", "confidence", "needs_human_approval", "next_action",
    "audit_results", "information_requests"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "run_id": { "type": "string", "format": "uuid" },
    "task_id": { "type": "string", "format": "uuid" },
    "dispatch_epoch": { "type": ["integer", "null"], "minimum": 0 },
    "agent_code": {
      "enum": ["evaluation-manager", "product-engineering", "user-evidence", "business-investment", "geo-policy-trend", "evidence-auditor"]
    },
    "status": { "enum": ["SUCCEEDED", "BLOCKED", "FAILED", "NEEDS_INPUT"] },
    "dimension": { "type": "string", "minLength": 1 },
    "claims": { "type": "array", "maxItems": 20, "items": { "type": "object" } },
    "evidence_refs": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "format": "uuid" }
    },
    "risk": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "needs_human_approval": { "type": "boolean" },
    "failure_class": { "type": ["string", "null"] },
    "next_action": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "audit_results": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "../audit/audit-result.v2.json" }
    },
    "information_requests": { "type": "array", "items": { "type": "object" } },
    "skill_result_ref": { "type": ["string", "null"], "format": "uuid" },
    "skill_result_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "validation_mode": {
      "type": ["string", "null"],
      "enum": ["first_validation", "version_regression", "evidence_recheck", null]
    }
  }
}
