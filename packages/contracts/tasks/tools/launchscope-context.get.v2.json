{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchscope.local/contracts/tools/launchscope-context.get.v2.json",
  "x-network-policy": {"allowed_domains": [], "max_redirects": 0, "max_response_bytes": 65536},
  "x-execution-policy": {"timeout_seconds": 15, "max_cost": 0},
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "tool_id", "permission", "network_level", "read_only", "input_schema", "output_schema"],
  "properties": {
    "contract_version": {"const": "2.0"},
    "tool_id": {"const": "launchscope-context.get.v2"},
    "permission": {"const": "context.read"},
    "network_level": {"const": "INTERNAL"},
    "read_only": {"const": true},
    "input_schema": {"type": "object", "additionalProperties": false},
    "output_schema": {
      "type": "object",
      "required": ["run_id", "task_id", "product_profile", "evidence_refs", "material_catalog", "material_scope"],
      "properties": {
        "run_id": {"type": "string", "format": "uuid"},
        "task_id": {"type": "string", "format": "uuid"},
        "product_profile": {"type": "object"},
        "evidence_refs": {"type": "array"},
        "material_catalog": {"type": "array"},
        "material_scope": {"type": "array"}
      }
    }
  }
}
