{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchscope.local/contracts/tools/material.read.v1.json",
  "x-network-policy": {"allowed_domains": [], "max_redirects": 0, "max_response_bytes": 65536},
  "x-execution-policy": {"timeout_seconds": 15, "max_cost": 0},
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "tool_id", "permission", "network_level", "read_only", "input_schema", "output_schema"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "tool_id": {"const": "material.read.v1"},
    "permission": {"const": "material.read"},
    "network_level": {"const": "INTERNAL"},
    "read_only": {"const": true},
    "input_schema": {
      "type": "object", "additionalProperties": false, "required": ["unit_refs", "purpose"],
      "properties": {
        "unit_refs": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string"}},
        "purpose": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "output_schema": {
      "type": "object", "additionalProperties": false, "required": ["receipt_id", "units", "truncated"],
      "properties": {
        "receipt_id": {"type": "string", "format": "uuid"},
        "units": {"type": "array", "maxItems": 8},
        "truncated": {"type": "boolean"}
      }
    }
  }
}
