{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchscope.local/contracts/run-manifest/run-manifest.v3.json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "agent_contract_generation", "agents", "skills", "tools", "standard_version",
    "budget", "limits", "failure_policy", "model_runtime", "user_validation"
  ],
  "properties": {
    "schema_version": { "const": "3.0" },
    "agent_contract_generation": { "const": "v3" },
    "agents": { "type": "object", "minProperties": 6 },
    "skills": { "type": "object", "minProperties": 7 },
    "tools": { "type": "object" },
    "standard_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "budget": { "type": "object" },
    "limits": { "type": "object" },
    "model_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user-evidence"],
      "properties": {
        "user-evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["api_style", "model_id", "configuration_sha256"],
          "properties": {
            "api_style": { "const": "openai-compatible" },
            "model_id": { "type": "string", "minLength": 1 },
            "configuration_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      }
    },
    "failure_policy": {
      "type": "object",
      "required": ["SUBMISSION_UNKNOWN", "TOOL_SIDE_EFFECT_UNKNOWN"],
      "properties": {
        "SUBMISSION_UNKNOWN": { "const": "NEEDS_ATTENTION_NO_RETRY" },
        "TOOL_SIDE_EFFECT_UNKNOWN": { "const": "NEEDS_ATTENTION_NO_RETRY" }
      }
    },
    "user_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled", "mode", "validation_script_sha256", "skill_version", "presentation_version",
        "skill_manifest_sha256", "package_sha256", "runner_sha256", "prompt_sha256",
        "knowledge_package_sha256", "input_schema_sha256", "output_schema_sha256"
      ],
      "properties": {
        "enabled": { "const": true },
        "mode": { "enum": ["first_validation", "version_regression", "evidence_recheck"] },
        "change_reason": {
          "type": ["string", "null"],
          "enum": [
            null,
            "no_completed_user_validation_history",
            "validation_script_hash_changed",
            "standard_version_changed",
            "explicit_user_evidence_recheck"
          ]
        },
        "validation_script_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "skill_version": { "const": "1.0.5" },
        "presentation_version": { "const": "0.4" },
        "skill_manifest_sha256": { "const": "0964927ad124e301386b21626ef59f2f161230c55acc534b980b2a267d3ad285" },
        "package_sha256": { "const": "ac17e6b8c9b82760593a8a51eb2ab9959b0ff072a125f8237a19d52f21409192" },
        "runner_sha256": { "const": "f0923fd01aa203217b85d1c6683dc7783cf1af10019f13302dadda13d37b10f0" },
        "prompt_sha256": { "const": "a46381cbe819f6e09ae7df196295989bd4b3261470474be201497debd2e341a2" },
        "knowledge_package_sha256": { "const": "d5951922224c9d16e9b013139795d074c706c3f589f8ffec918c499e910300d2" },
        "input_schema_sha256": { "const": "676b1d0968b1337bae5aa60dd148a17b94f885b874eddbb68cc1ea3ab816ce05" },
        "output_schema_sha256": { "const": "81bfb80b385bfc9e3cb9429c88aae6eeeb40251c64817eccceed291c16990fbf" }
      }
    }
  }
}
