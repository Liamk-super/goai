{
  "schema_version": "1.0",
  "profile_id": "investment-review",
  "version": "1.0",
  "evaluation_mode": "INVESTMENT_REVIEW",
  "weights": { "user_value": 0.25, "product_capability": 0.20, "investment_potential": 0.45, "evidence_quality": 0.10 },
