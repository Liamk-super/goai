{
  "schema_version": "1.0",
  "profile_id": "user-validation",
  "version": "1.0",
  "evaluation_mode": "USER_VALIDATION",
  "weights": { "user_value": 0.75, "evidence_quality": 0.25 },
  "thresholds": { "PROCEED": 80, "VALIDATE_FURTHER": 60, "ADJUST": 40 },
  "required_agents": ["user-evidence"],
  "coverage_rules": { "proceed_minimum": 0.70, "scoring_minimum": 0.50, "rejected_findings_score_zero": true },
  "recommendation_caps": { "missing_optional_agent": "VALIDATE_FURTHER", "unresolved_conflict": "VALIDATE_FURTHER", "low_coverage": "VALIDATE_FURTHER" }
}
