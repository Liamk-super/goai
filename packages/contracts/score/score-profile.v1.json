{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchscope.local/contracts/score/score-profile.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "profile_id", "version", "evaluation_mode", "weights", "thresholds",
    "required_agents", "coverage_rules", "recommendation_caps"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "profile_id": { "type": "string", "pattern": "^[a-z][a-z-]+$" },
    "version": { "const": "1.0" },
    "evaluation_mode": { "enum": ["FULL_POTENTIAL", "INVESTMENT_REVIEW", "LAUNCH_REVIEW", "USER_VALIDATION"] },
    "weights": {
      "type": "object", "minProperties": 1,
      "additionalProperties": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
    },
    "thresholds": {
      "type": "object", "additionalProperties": false,
      "required": ["PROCEED", "VALIDATE_FURTHER", "ADJUST"],
      "properties": {
        "PROCEED": { "type": "number", "minimum": 0, "maximum": 100 },
        "VALIDATE_FURTHER": { "type": "number", "minimum": 0, "maximum": 100 },
        "ADJUST": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "required_agents": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["user-evidence", "product-engineering", "business-investment"] }
    },
    "coverage_rules": {
      "type": "object", "additionalProperties": false,
      "required": ["proceed_minimum", "scoring_minimum", "rejected_findings_score_zero"],
      "properties": {
        "proceed_minimum": { "type": "number", "minimum": 0, "maximum": 1 },
        "scoring_minimum": { "type": "number", "minimum": 0, "maximum": 1 },
        "rejected_findings_score_zero": { "const": true }
      }
    },
    "recommendation_caps": {
      "type": "object", "additionalProperties": false,
      "required": ["missing_optional_agent", "unresolved_conflict", "low_coverage"],
      "properties": {
        "missing_optional_agent": { "enum": ["PROCEED", "VALIDATE_FURTHER", "ADJUST", "PAUSE"] },
        "unresolved_conflict": { "enum": ["VALIDATE_FURTHER", "ADJUST", "PAUSE"] },
        "low_coverage": { "enum": ["VALIDATE_FURTHER", "ADJUST", "PAUSE"] }
      }
    }
  }
}
