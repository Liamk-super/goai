{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchscope.local/contracts/events/evaluation-events.v1.json",
  "title": "LaunchScope evaluation events v1",
  "description": "Versioned domain events for the evaluation lifecycle. Consumers must tolerate additive payload fields and accept the current and immediately previous released minor version.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/ProjectCreated" },
    { "$ref": "#/$defs/ProductVersionSubmitted" },
    { "$ref": "#/$defs/IntakeGapIdentified" },
    { "$ref": "#/$defs/ProfileConfirmed" },
    { "$ref": "#/$defs/EvaluationRunStarted" },
    { "$ref": "#/$defs/TaskDispatched" },
    { "$ref": "#/$defs/EvidenceCaptured" },
    { "$ref": "#/$defs/FindingSubmitted" },
    { "$ref": "#/$defs/EvidenceAuditCompleted" },
    { "$ref": "#/$defs/ApprovalRequested" },
    { "$ref": "#/$defs/ApprovalResolved" },
    { "$ref": "#/$defs/RunNeedsAttention" },
    { "$ref": "#/$defs/DecisionSynthesized" },
    { "$ref": "#/$defs/DossierCommitted" },
    { "$ref": "#/$defs/VersionRegressionCompleted" },
    { "$ref": "#/$defs/RunCompleted" },
    { "$ref": "#/$defs/RunFailed" }
  ],
  "x-contract-version": "1.0",
  "x-compatibility": {
    "consumer-rule": "accept-current-and-immediately-previous-released-minor",
    "breaking-change": "new-major-file",
    "published-schema-is-immutable": true
  },
  "$defs": {
    "Uuid": {
      "type": "string",
      "format": "uuid"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "UuidList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/Uuid"
      }
    },
    "StageCode": {
      "type": "string",
      "enum": [
        "INTAKE",
        "GAP_ANALYSIS",
        "PROFILE_CONFIRMATION",
        "PLANNING",
        "PARALLEL_EVALUATION",
        "EVIDENCE_REVIEW",
        "REMEDIATION",
        "SYNTHESIS",
        "DOSSIER_COMMIT",
        "VERSION_REGRESSION"
      ]
    },
    "DimensionCode": {
      "type": "string",
      "enum": [
        "PRODUCT_IMPLEMENTATION",
        "USER_USAGE",
        "BUSINESS_INVESTMENT",
        "GEO_POLICY_TREND"
      ]
    },
    "FindingGrade": {
      "type": "string",
      "enum": [
        "STRONG",
        "MODERATE",
        "WEAK",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "FailureClass": {
      "type": "string",
      "enum": [
        "TRANSIENT",
        "VALIDATION",
        "AUTHORIZATION",
        "DEPENDENCY",
        "BUDGET",
        "POLICY",
        "SUBMISSION_UNKNOWN",
        "BUSINESS"
      ]
    },
    "CommonPayload": {
      "type": "object",
      "additionalProperties": true
    },
    "ProjectCreatedPayload": {
      "type": "object",
      "properties": {
        "project_id": { "$ref": "#/$defs/Uuid" },
        "workspace_id": { "$ref": "#/$defs/Uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "required": ["project_id", "workspace_id", "name"],
      "additionalProperties": false
    },
    "ProductVersionSubmittedPayload": {
      "type": "object",
      "properties": {
        "project_id": { "$ref": "#/$defs/Uuid" },
        "product_version_id": { "$ref": "#/$defs/Uuid" },
        "material_ids": { "$ref": "#/$defs/UuidList" },
        "submitted_by": { "type": "string", "minLength": 1 }
      },
      "required": ["project_id", "product_version_id", "material_ids", "submitted_by"],
      "additionalProperties": false
    },
    "IntakeGapIdentifiedPayload": {
      "type": "object",
      "properties": {
        "project_id": { "$ref": "#/$defs/Uuid" },
        "product_version_id": { "$ref": "#/$defs/Uuid" },
        "gap_ids": { "$ref": "#/$defs/UuidList" },
        "question_count": { "type": "integer", "minimum": 0 }
      },
      "required": ["project_id", "product_version_id", "gap_ids", "question_count"],
      "additionalProperties": false
    },
    "ProfileConfirmedPayload": {
      "type": "object",
      "properties": {
        "project_id": { "$ref": "#/$defs/Uuid" },
        "product_version_id": { "$ref": "#/$defs/Uuid" },
        "profile_id": { "$ref": "#/$defs/Uuid" },
        "confirmed_by": { "type": "string", "minLength": 1 }
      },
      "required": ["project_id", "product_version_id", "profile_id", "confirmed_by"],
      "additionalProperties": false
    },
    "EvaluationRunStartedPayload": {
      "type": "object",
      "properties": {
        "project_id": { "$ref": "#/$defs/Uuid" },
        "product_version_id": { "$ref": "#/$defs/Uuid" },
        "run_manifest_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "run_manifest_sha256": { "$ref": "#/$defs/Sha256" },
        "standard_version": { "type": "string", "minLength": 1 }
      },
      "required": ["project_id", "product_version_id", "run_manifest_version", "run_manifest_sha256", "standard_version"],
      "additionalProperties": false
    },
    "TaskDispatchedPayload": {
      "type": "object",
      "properties": {
        "task_id": { "$ref": "#/$defs/Uuid" },
        "stage_code": { "$ref": "#/$defs/StageCode" },
        "agent_identity_ref": { "type": "string", "minLength": 1 },
        "skill_ref": { "type": "string", "minLength": 1 },
        "skill_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
      },
      "required": ["task_id", "stage_code", "agent_identity_ref", "skill_ref", "skill_version"],
      "additionalProperties": false
    },
    "EvidenceCapturedPayload": {
      "type": "object",
      "properties": {
        "evidence_id": { "$ref": "#/$defs/Uuid" },
        "source_type": {
          "type": "string",
          "enum": ["MATERIAL", "PUBLIC_RESEARCH", "AUTHENTICATED_RESEARCH", "DERIVED"]
        },
        "sha256": { "$ref": "#/$defs/Sha256" },
        "trust_level": {
          "type": "string",
          "enum": ["E0", "E1", "E2", "E3", "E4", "E5"]
        }
      },
      "required": ["evidence_id", "source_type", "sha256", "trust_level"],
      "additionalProperties": false
    },
    "FindingSubmittedPayload": {
      "type": "object",
      "properties": {
        "finding_id": { "$ref": "#/$defs/Uuid" },
        "dimension_code": { "$ref": "#/$defs/DimensionCode" },
        "evidence_ids": { "$ref": "#/$defs/UuidList" },
        "grade": { "$ref": "#/$defs/FindingGrade" },
        "is_hypothesis": { "type": "boolean" }
      },
      "required": ["finding_id", "dimension_code", "evidence_ids", "grade", "is_hypothesis"],
      "additionalProperties": false
    },
    "EvidenceAuditCompletedPayload": {
      "type": "object",
      "properties": {
        "audit_id": { "$ref": "#/$defs/Uuid" },
        "evidence_id": { "$ref": "#/$defs/Uuid" },
        "decision": {
          "type": "string",
          "enum": ["ACCEPTED", "DOWNGRADED", "REJECTED", "NEEDS_MORE_EVIDENCE"]
        }
      },
      "required": ["audit_id", "evidence_id", "decision"],
      "additionalProperties": false
    },
    "ApprovalRequestedPayload": {
      "type": "object",
      "properties": {
        "approval_request_id": { "$ref": "#/$defs/Uuid" },
        "action": { "type": "string", "minLength": 1 },
        "parameters_sha256": { "$ref": "#/$defs/Sha256" },
        "expires_at": { "type": "string", "format": "date-time" },
        "estimated_cost": { "type": "number", "minimum": 0 }
      },
      "required": ["approval_request_id", "action", "parameters_sha256", "expires_at", "estimated_cost"],
      "additionalProperties": false
    },
    "ApprovalResolvedPayload": {
      "type": "object",
      "properties": {
        "approval_request_id": { "$ref": "#/$defs/Uuid" },
        "decision": { "type": "string", "enum": ["APPROVED", "REJECTED", "EXPIRED"] },
        "resolved_by": { "type": "string", "minLength": 1 }
      },
      "required": ["approval_request_id", "decision", "resolved_by"],
      "additionalProperties": false
    },
    "RunNeedsAttentionPayload": {
      "type": "object",
      "properties": {
        "reason_code": { "type": "string", "minLength": 1 },
        "failure_class": { "$ref": "#/$defs/FailureClass" },
        "retry_blocked": { "type": "boolean", "const": true }
      },
      "required": ["reason_code", "failure_class", "retry_blocked"],
      "additionalProperties": false
    },
    "DecisionSynthesizedPayload": {
      "type": "object",
      "properties": {
        "decision_id": { "$ref": "#/$defs/Uuid" },
        "recommendation": { "type": "string", "enum": ["PROCEED", "VALIDATE_FURTHER", "ADJUST", "PAUSE"] },
        "standard_version": { "type": "string", "minLength": 1 },
        "finding_ids": { "$ref": "#/$defs/UuidList" },
        "blocking_count": { "type": "integer", "minimum": 0 }
      },
      "required": ["decision_id", "recommendation", "standard_version", "finding_ids", "blocking_count"],
      "additionalProperties": false
    },
    "DossierCommittedPayload": {
      "type": "object",
      "properties": {
        "dossier_id": { "$ref": "#/$defs/Uuid" },
        "project_id": { "$ref": "#/$defs/Uuid" },
        "product_version_id": { "$ref": "#/$defs/Uuid" },
        "report_id": { "$ref": "#/$defs/Uuid" }
      },
      "required": ["dossier_id", "project_id", "product_version_id", "report_id"],
      "additionalProperties": false
    },
    "VersionRegressionCompletedPayload": {
      "type": "object",
      "properties": {
        "project_id": { "$ref": "#/$defs/Uuid" },
        "base_version_id": { "$ref": "#/$defs/Uuid" },
        "candidate_version_id": { "$ref": "#/$defs/Uuid" },
        "standard_version": { "type": "string", "minLength": 1 },
        "result": { "type": "string", "enum": ["PASS", "FAIL", "INSUFFICIENT_EVIDENCE"] }
      },
      "required": ["project_id", "base_version_id", "candidate_version_id", "standard_version", "result"],
      "additionalProperties": false
    },
    "RunCompletedPayload": {
      "type": "object",
      "properties": {
        "decision_id": { "$ref": "#/$defs/Uuid" },
        "standard_version": { "type": "string", "minLength": 1 },
        "completed_stage_count": { "type": "integer", "minimum": 1, "maximum": 10 }
      },
      "required": ["decision_id", "standard_version", "completed_stage_count"],
      "additionalProperties": false
    },
    "RunFailedPayload": {
      "type": "object",
      "properties": {
        "failure_class": { "$ref": "#/$defs/FailureClass" },
        "reason_code": { "type": "string", "minLength": 1 },
        "retry_permitted": { "type": "boolean" }
      },
      "required": ["failure_class", "reason_code", "retry_permitted"],
      "additionalProperties": false,
      "if": {
        "properties": {
          "failure_class": { "const": "SUBMISSION_UNKNOWN" }
        }
      },
      "then": {
        "properties": {
          "retry_permitted": { "const": false }
        }
      }
    },
    "ProjectCreated": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/EventEnvelope" },
        {
          "type": "object",
          "properties": {
            "event_type": { "const": "project.created" },
            "payload": { "$ref": "#/$defs/ProjectCreatedPayload" }
          },
          "required": ["event_type"]
        }
      ]
    },
    "ProductVersionSubmitted": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/EventEnvelope" },
        {
          "type": "object",
          "properties": {
            "event_type": { "const": "product_version.submitted" },
            "payload": { "$ref": "#/$defs/ProductVersionSubmittedPayload" }
          },
          "required": ["event_type"]
        }
      ]
    },
    "IntakeGapIdentified": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/EventEnvelope" },
        {
          "type": "object",
          "properties": {
            "event_type": { "const": "intake.gap_identified" },
            "payload": { "$ref": "#/$defs/IntakeGapIdentifiedPayload" }
          },
          "required": ["event_type"]
        }
      ]
    },
    "ProfileConfirmed": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/EventEnvelope" },
        {
          "type": "object",
          "properties": {
            "event_type": { "const": "profile.confirmed" },
            "payload": { "$ref": "#/$defs/ProfileConfirmedPayload" }
          },
          "required": ["event_type"]
        }
      ]
    },
    "EvaluationRunStarted": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/EventEnvelope" },
        {
          "type": "object",
          "properties": {
            "event_type": { "const": "evaluation.run.started" },
            "payload": { "$ref": "#/$defs/EvaluationRunStartedPayload" }
          },
          "required": ["event_type"]
        }
      ]
    },
    "TaskDispatched": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/EventEnvelope" },
        {
          "type": "object",
          "properties": {
            "event_type": { "const": "task.dispatched" },
            "task_id": { "$ref": "#/$defs/Uuid" },
            "payload": { "$ref": "#/$defs/TaskDispatchedPayload" }
          },
          "required": ["event_type", "task_id"]
        }
      ]
    },
    "EvidenceCaptured": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/EventEnvelope" },
        {
          "type": "object",
          "properties": {
            "event_type": { "const": "evidence.captured" },
            "payload": { "$ref": "#/$defs/EvidenceCapturedPayload" }
          },
          "required": ["event_type"]
        }
      ]
    },
    "FindingSubmitted": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/EventEnvelope" },
        {
          "type": "object",
          "properties": {
            "event_type": { "const": "finding.submitted" },
            "payload": { "$ref": "#/$defs/FindingSubmittedPayload" }
          },
          "required": ["event_type"]
        }
      ]
    },
    "EvidenceAuditCompleted": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/EventEnvelope" },
        {
          "type": "object",
          "properties": {
            "event_type": { "const": "evidence.audit_completed" },
            "payload": { "$ref": "#/$defs/EvidenceAuditCompletedPayload" }
          },
          "required": ["event_type"]
        }
      ]
    },
    "ApprovalRequested": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/EventEnvelope" },
        {
          "type": "object",
          "properties": {
            "event_type": { "const": "approval.requested" },
            "payload": { "$ref": "#/$defs/ApprovalRequestedPayload" }
          },
          "required": ["event_type"]
        }
      ]
    },
    "ApprovalResolved": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/EventEnvelope" },
        {
          "type": "object",
          "properties": {
            "event_type": { "const": "approval.resolved" },
            "payload": { "$ref": "#/$defs/ApprovalResolvedPayload" }
          },
          "required": ["event_type"]
        }
      ]
    },
    "RunNeedsAttention": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/EventEnvelope" },
        {
          "type": "object",
          "properties": {
            "event_type": { "const": "run.needs_attention" },
            "payload": { "$ref": "#/$defs/RunNeedsAttentionPayload" }
          },
          "required": ["event_type"]
        }
      ]
    },
    "DecisionSynthesized": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/EventEnvelope" },
        {
          "type": "object",
          "properties": {
            "event_type": { "const": "decision.synthesized" },
            "payload": { "$ref": "#/$defs/DecisionSynthesizedPayload" }
          },
          "required": ["event_type"]
        }
      ]
    },
    "DossierCommitted": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/EventEnvelope" },
        {
          "type": "object",
          "properties": {
            "event_type": { "const": "dossier.committed" },
            "payload": { "$ref": "#/$defs/DossierCommittedPayload" }
          },
          "required": ["event_type"]
        }
      ]
    },
    "VersionRegressionCompleted": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/EventEnvelope" },
        {
          "type": "object",
          "properties": {
            "event_type": { "const": "version.regression_completed" },
            "payload": { "$ref": "#/$defs/VersionRegressionCompletedPayload" }
          },
          "required": ["event_type"]
        }
      ]
    },
    "RunCompleted": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/EventEnvelope" },
        {
          "type": "object",
          "properties": {
            "event_type": { "const": "run.completed" },
            "payload": { "$ref": "#/$defs/RunCompletedPayload" }
          },
          "required": ["event_type"]
        }
      ]
    },
    "RunFailed": {
      "allOf": [
        { "$ref": "envelope.schema.json#/$defs/EventEnvelope" },
        {
          "type": "object",
          "properties": {
            "event_type": { "const": "run.failed" },
            "payload": { "$ref": "#/$defs/RunFailedPayload" }
          },
          "required": ["event_type"]
        }
      ]
    }
  },
