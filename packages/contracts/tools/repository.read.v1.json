{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchscope.local/contracts/tools/repository.read.v1.json",
  "x-network-policy": {"allowed_domains": [], "max_redirects": 0, "max_response_bytes": 0},
  "x-execution-policy": {"timeout_seconds": 30, "max_cost": 0},
  "title": "repository.read v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "tool_id", "risk_tier", "permission", "network_level", "read_only", "input_schema", "output_schema", "execution_policy", "evidence_requirements"],
  "properties": {
    "contract_version": {"const": "1.0"}, "tool_id": {"const": "repository.read.v1"}, "risk_tier": {"const": "LOW"}, "permission": {"const": "repository.read"}, "network_level": {"const": "NONE"}, "read_only": {"const": true},
    "input_schema": {"type": "object", "additionalProperties": false, "required": ["path"], "properties": {"path": {"type": "string", "minLength": 1}, "max_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}}},
    "output_schema": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "content"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "content": {"type": "string", "maxLength": 1048576}}},
    "execution_policy": {"type": "object", "additionalProperties": false, "required": ["timeout_seconds", "retryable_failures", "max_cost"], "properties": {"timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 900}, "retryable_failures": {"const": []}, "max_cost": {"const": 0}}}, "evidence_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "data_egress": {"const": "none"}
  },
  "examples": [{"contract_version": "1.0", "tool_id": "repository.read.v1", "risk_tier": "LOW", "permission": "repository.read", "network_level": "NONE", "read_only": true, "input_schema": {"path": "README.md"}, "output_schema": {"path": "README.md", "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "content": "Read-only source"}, "execution_policy": {"timeout_seconds": 30, "retryable_failures": [], "max_cost": 0}, "evidence_requirements": ["content_sha256"], "data_egress": "none"}]
}
