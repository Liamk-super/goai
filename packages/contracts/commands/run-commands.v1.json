{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchscope.local/contracts/commands/run-commands.v1.json",
  "title": "LaunchScope run commands v1",
  "description": "Commands accepted by the control plane or dispatched to an isolated worker. Commands request state changes; PostgreSQL remains the only state authority.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/StartRun" },
    { "$ref": "#/$defs/DispatchTask" },
    { "$ref": "#/$defs/CaptureEvidence" },
    { "$ref": "#/$defs/SynthesizeDecision" },
    { "$ref": "#/$defs/CancelRun" },
    { "$ref": "#/$defs/ResolveApproval" }
  ],
  "x-contract-version": "1.0",
  "x-compatibility": {
    "breaking-change": "new-major-file",
    "published-schema-is-immutable": true,
    "idempotency": "same-tenant-and-idempotency-key-must-not-create-a-second-state-change"
  },
  "$defs": {
    "Uuid": {
      "type": "string",
      "format": "uuid"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "UuidList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/Uuid" }
    },
    "StartRunPayload": {
      "type": "object",
      "properties": {
        "project_id": { "$ref": "#/$defs/Uuid" },
        "product_version_id": { "$ref": "#/$defs/Uuid" },
        "standard_version": { "type": "string", "minLength": 1 },
        "run_manifest_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "run_manifest_sha256": { "$ref": "#/$defs/Sha256" }
      },
      "required": ["project_id", "product_version_id", "standard_version", "run_manifest_version", "run_manifest_sha256"],
      "additionalProperties": false
    },
    "DispatchTaskPayload": {
      "type": "object",
      "properties": {
        "task_id": { "$ref": "#/$defs/Uuid" },
        "stage_code": { "type": "string", "minLength": 1 },
        "agent_identity_ref": { "type": "string", "minLength": 1 },
        "skill_ref": { "type": "string", "minLength": 1 },
        "skill_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "input_ref": { "type": "string", "minLength": 1 }
      },
      "required": ["task_id", "stage_code", "agent_identity_ref", "skill_ref", "skill_version", "input_ref"],
      "additionalProperties": false
    },
    "CaptureEvidencePayload": {
      "type": "object",
      "properties": {
        "evidence_id": { "$ref": "#/$defs/Uuid" },
        "source_ref": { "type": "string", "minLength": 1 },
        "source_type": { "type": "string", "enum": ["MATERIAL", "PUBLIC_RESEARCH", "AUTHENTICATED_RESEARCH"] },
        "read_only": { "type": "boolean", "const": true },
        "capture_policy_version": { "type": "string", "minLength": 1 }
      },
      "required": ["evidence_id", "source_ref", "source_type", "read_only", "capture_policy_version"],
      "additionalProperties": false
    },
    "SynthesizeDecisionPayload": {
      "type": "object",
      "properties": {
        "finding_ids": { "$ref": "#/$defs/UuidList" },
        "standard_version": { "type": "string", "minLength": 1 },
        "decision_policy_version": { "type": "string", "minLength": 1 }
      },
      "required": ["finding_ids", "standard_version", "decision_policy_version"],
      "additionalProperties": false
    },
    "CancelRunPayload": {
      "type": "object",
      "properties": {
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
      },
      "required": ["reason"],
      "additionalProperties": false
    },
    "ResolveApprovalPayload": {
      "type": "object",
      "properties": {
        "approval_request_id": { "$ref": "#/$defs/Uuid" },
        "decision": { "type": "string", "enum": ["APPROVED", "REJECTED"] },
        "parameters_sha256": { "$ref": "#/$defs/Sha256" }
      },
      "required": ["approval_request_id", "decision", "parameters_sha256"],
      "additionalProperties": false
    },
    "StartRun": {
      "allOf": [
        { "$ref": "../events/envelope.schema.json#/$defs/CommandEnvelope" },
        {
          "type": "object",
          "properties": {
            "command_type": { "const": "evaluation.run.start" },
            "task_id": { "type": "null" },
            "payload": { "$ref": "#/$defs/StartRunPayload" }
          },
          "required": ["command_type", "task_id"]
        }
      ]
    },
    "DispatchTask": {
      "allOf": [
        { "$ref": "../events/envelope.schema.json#/$defs/CommandEnvelope" },
        {
          "type": "object",
          "properties": {
            "command_type": { "const": "evaluation.task.dispatch" },
            "task_id": { "$ref": "#/$defs/Uuid" },
            "payload": { "$ref": "#/$defs/DispatchTaskPayload" }
          },
          "required": ["command_type", "task_id"]
        }
      ]
    },
    "CaptureEvidence": {
      "allOf": [
        { "$ref": "../events/envelope.schema.json#/$defs/CommandEnvelope" },
        {
          "type": "object",
          "properties": {
            "command_type": { "const": "evidence.capture.request" },
            "payload": { "$ref": "#/$defs/CaptureEvidencePayload" }
          },
          "required": ["command_type"]
        }
      ]
    },
    "SynthesizeDecision": {
      "allOf": [
        { "$ref": "../events/envelope.schema.json#/$defs/CommandEnvelope" },
        {
          "type": "object",
          "properties": {
            "command_type": { "const": "decision.synthesize" },
            "payload": { "$ref": "#/$defs/SynthesizeDecisionPayload" }
          },
          "required": ["command_type"]
        }
      ]
    },
    "CancelRun": {
      "allOf": [
        { "$ref": "../events/envelope.schema.json#/$defs/CommandEnvelope" },
        {
          "type": "object",
          "properties": {
            "command_type": { "const": "evaluation.run.cancel" },
            "payload": { "$ref": "#/$defs/CancelRunPayload" }
          },
          "required": ["command_type"]
        }
      ]
    },
    "ResolveApproval": {
      "allOf": [
        { "$ref": "../events/envelope.schema.json#/$defs/CommandEnvelope" },
        {
          "type": "object",
          "properties": {
            "command_type": { "const": "approval.resolve" },
            "payload": { "$ref": "#/$defs/ResolveApprovalPayload" }
          },
          "required": ["command_type"]
        }
      ]
    }
  },
  "examples": [
    {
      "command_type": "evaluation.run.start",
      "event_id": "a0000000-0000-4000-8000-000000000001",
      "tenant_id": "b0000000-0000-4000-8000-000000000001",
      "run_id": "c0000000-0000-4000-8000-000000000001",
      "task_id": null,
      "correlation_id": "d0000000-0000-4000-8000-000000000001",
      "causation_id": null,
      "idempotency_key": "command-run-start-1",
      "schema_version": "1.0",
      "occurred_at": "2026-08-05T08:00:00Z",
      "payload": {
        "project_id": "e0000000-0000-4000-8000-000000000001",
