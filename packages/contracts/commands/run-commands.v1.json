        "input_ref": "run-state-ref:c0000000-0000-4000-8000-000000000001:task:f0000000-0000-4000-8000-000000000002"
      }
    },
    {
      "command_type": "evidence.capture.request",
      "event_id": "a0000000-0000-4000-8000-000000000003",
      "tenant_id": "b0000000-0000-4000-8000-000000000001",
      "run_id": "c0000000-0000-4000-8000-000000000001",
      "task_id": "f0000000-0000-4000-8000-000000000002",
      "correlation_id": "d0000000-0000-4000-8000-000000000001",
      "causation_id": "a0000000-0000-4000-8000-000000000002",
      "idempotency_key": "command-evidence-capture-1",
      "schema_version": "1.0",
      "occurred_at": "2026-08-05T08:02:00Z",
      "payload": {
        "evidence_id": "f0000000-0000-4000-8000-000000000003",
        "source_ref": "material:80000000-0000-4000-8000-000000000001",
