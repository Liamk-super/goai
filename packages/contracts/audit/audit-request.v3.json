{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchscope.local/contracts/audit/audit-request.v3.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "request_id", "run_id", "audit_round", "finding_ids", "report_refs",
    "evidence_refs", "score_profile_ref"
  ],
  "properties": {
    "schema_version": { "const": "3.0" },
    "request_id": { "type": "string", "format": "uuid" },
    "run_id": { "type": "string", "format": "uuid" },
    "audit_round": { "type": "integer", "minimum": 1, "maximum": 2 },
    "finding_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "format": "uuid" } },
    "report_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/contentRef" } },
    "evidence_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/contentRef" } },
    "score_profile_ref": { "type": "string", "pattern": "^score-profile:[a-z-]+@1\\.0$" }
  },
  "$defs": {
    "contentRef": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
