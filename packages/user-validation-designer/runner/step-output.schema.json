{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "launchscope://skills/user-validation-designer/1.0.5/step-output",
  "title": "User validation Agent step output",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "detail"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "partial", "failed", "blocked", "not_executable"]
    },
    "detail": { "type": "string", "minLength": 1 },
    "failure_reason": { "type": ["string", "null"] },
    "tool_call_id": { "type": ["string", "null"] },
    "personas": { "$ref": "#/definitions/object_array" },
    "jobs": { "$ref": "#/definitions/object_array" },
    "segments": { "$ref": "#/definitions/object_array" },
    "scenarios": { "$ref": "#/definitions/object_array" },
    "firstExperience": { "$ref": "#/definitions/object_array" },
    "taskTests": { "$ref": "#/definitions/object_array" },
    "interview": { "$ref": "#/definitions/object_array" },
    "hiddenNeeds": { "$ref": "#/definitions/object_array" },
    "insights": { "$ref": "#/definitions/object_array" },
    "politenessRemoved": { "$ref": "#/definitions/object_array" },
    "hypotheses": { "$ref": "#/definitions/object_array" },
    "plans": { "$ref": "#/definitions/object_array" },
    "experienceIssues": { "$ref": "#/definitions/object_array" },
    "conflictCandidates": { "$ref": "#/definitions/object_array" },
    "evidence": { "$ref": "#/definitions/object_array" },
    "dimensions": {
      "type": "object",
      "additionalProperties": { "type": "object" }
    },
    "flags": {
      "type": "object",
      "additionalProperties": { "type": ["boolean", "string", "number", "null"] }
    },
    "negativeFindings": { "type": "integer", "minimum": 0, "maximum": 1000 }
  },
  "definitions": {
    "object_array": {
      "type": "array",
      "maxItems": 500,
      "items": { "type": "object" }
    }
  }
}
