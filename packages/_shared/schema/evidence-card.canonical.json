{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "launchscope://shared/evidence-card/2.0",
  "title": "LaunchScope canonical Evidence Card v2.0",
  "description": "Common immutable evidence shape. Skill-specific schemas may narrow evidence_type, reliability_level, and valid_for_dimensions but may not remove required provenance fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "evidence_type",
    "source",
    "source_tier",
    "timestamp",
    "reliability_level",
    "supporting_claims",
    "applicability",
    "expiry",
    "content_hash",
    "observation",
    "fact_type"
  ],
  "properties": {
    "evidence_id": { "type": "string", "pattern": "^EV-[A-Za-z0-9._-]+-[0-9]+$" },
    "evidence_type": {
      "type": "string",
      "enum": [
        "product_evidence",
        "technical_evidence",
        "engineering_evidence",
        "team_evidence",
        "persona_evidence",
        "scenario_evidence",
        "simulated_experience_evidence",
        "simulated_task_evidence",
        "simulated_interview_evidence",
        "real_user_evidence",
        "team_statement_evidence"
      ]
    },
    "source": { "type": "string", "minLength": 1 },
    "source_tier": {
      "type": "string",
      "enum": ["tier_1", "tier_2", "tier_3", "untraceable"]
    },
    "timestamp": { "type": "string", "minLength": 1 },
    "reliability_level": {
      "type": "string",
      "enum": ["E0", "E1", "E2", "E3", "E4", "E5"]
    },
    "supporting_claims": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_version", "scope", "valid_for_dimensions"],
      "properties": {
        "product_version": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "environment": { "type": ["string", "null"] },
        "persona_ids": {
          "type": ["array", "null"],
          "items": { "type": "string", "pattern": "^P[0-9]+$" }
        },
        "segment": { "type": ["string", "null"] },
        "valid_for_dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "product_completeness",
              "technical_architecture",
              "ai_capability",
              "engineering_quality",
              "team_delivery",
              "demand_strength",
              "usage_frequency",
              "pain_severity",
              "alternative_gap",
              "willingness_to_pay",
              "virality"
            ]
          }
        }
      }
    },
    "expiry": { "type": "string", "minLength": 1 },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "observation": { "type": "string", "minLength": 1 },
    "fact_type": { "type": "string", "enum": ["fact", "inference", "assumption"] },
    "conflict_with": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "simulation_note": { "type": ["string", "null"] },
    "repository_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_identity", "commit_sha", "path", "tool_call_id", "content_hash", "captured_at"],
      "properties": {
        "repository_identity": { "type": "string", "minLength": 1 },
        "commit_sha": { "type": "string", "minLength": 7 },
        "branch": { "type": ["string", "null"] },
        "path": { "type": "string", "minLength": 1 },
        "tool_call_id": { "type": "string", "minLength": 1 },
        "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "captured_at": { "type": "string", "minLength": 1 }
      }
    }
  }
}
