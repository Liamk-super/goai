# Copy this file to .env for local use and fill secret values through a local
# secret manager or an ephemeral shell. Never commit .env or put credentials in
# this template.

COMPOSE_PROJECT_NAME=
LAUNCHSCOPE_ENV=

# PostgreSQL
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=
POSTGRES_TEST_PORT=55432

# MinIO / S3-compatible evidence object store
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=
MINIO_CONSOLE_PORT=
MINIO_TEST_API_PORT=59000

# Private S3-compatible evidence store.  The bucket must not have a public
# policy; the control plane issues only 60-900 second signed PUT URLs.
LAUNCHSCOPE_S3_ENDPOINT=
LAUNCHSCOPE_EVIDENCE_BUCKET=
LAUNCHSCOPE_S3_ACCESS_KEY=
LAUNCHSCOPE_S3_SECRET_KEY=
LAUNCHSCOPE_S3_REGION=us-east-1
LAUNCHSCOPE_S3_PRESIGN_TTL_SECONDS=900

# Nacos configuration center
NACOS_AUTH_ENABLE=
NACOS_PORT=
NACOS_CLIENT_PORT=
NACOS_CLIENT_TLS_PORT=

# Higress gateway
HIGRESS_MODE=
HIGRESS_CONSOLE_PORT=
HIGRESS_HTTP_PORT=
HIGRESS_HTTPS_PORT=

# OpenTelemetry Collector
OTEL_GRPC_PORT=
OTEL_HTTP_PORT=
OTEL_HEALTH_PORT=

# RocketMQ
ROCKETMQ_NAMESRV_PORT=
ROCKETMQ_BROKER_VIP_PORT=
ROCKETMQ_BROKER_PORT=
ROCKETMQ_BROKER_HA_PORT=
