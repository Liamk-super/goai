{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchscope.local/schemas/runtime-config.v1.json",
  "title": "LaunchScope Local and Demo Runtime Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["environment", "schemaVersion", "migrationRevision", "imageDigests", "configHashes", "secretRefs"],
  "properties": {
    "environment": {"enum": ["Local", "Demo"]},
    "schemaVersion": {"const": "1.0"},
    "migrationRevision": {"const": "0012_t12_seed_p0_skills"},
    "imageDigests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "configHashes": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "secretRefs": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^(env|secret|vault)://"}
    },
    "features": {"type": "object", "additionalProperties": {"type": "boolean"}}
  }
}
