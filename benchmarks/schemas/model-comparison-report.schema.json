{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "case_ids", "minimum_repeats", "models", "recommendation"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "suite_id": {"const": "model-benchmark-v1"},
    "case_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "minimum_repeats": {"type": "integer", "minimum": 1},
    "models": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "repeats",
          "mean_automated_pass_rate",
          "critical_violations",
          "runtime_identity_verified",
          "input_tokens",
          "output_tokens",
          "cost_amount",
          "mean_latency_ms"
        ],
        "properties": {
          "model": {"type": "string"},
          "repeats": {"type": "integer", "minimum": 1},
          "mean_automated_pass_rate": {"type": "number", "minimum": 0, "maximum": 1},
          "critical_violations": {"type": "integer", "minimum": 0},
          "runtime_identity_verified": {"type": "boolean"},
          "input_tokens": {"type": "integer", "minimum": 0},
          "output_tokens": {"type": "integer", "minimum": 0},
          "cost_amount": {"type": "number", "minimum": 0},
          "mean_latency_ms": {"type": "number", "minimum": 0}
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "model", "reason"],
      "properties": {
        "status": {"enum": ["SELECTED", "NO_ELIGIBLE_MODEL", "TIE_REQUIRES_HUMAN"]},
        "model": {"type": ["string", "null"]},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
